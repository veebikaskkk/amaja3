{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "amaja-koduleht",
  "main": "worker.js",
  "compatibility_date": "2026-08-21",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "SAATJA": "Koduleht <info@amaja.ee>",
    "SAAJA": "info@a-maja.com"
  },
  "observability": {
    "enabled": true
  }
}
